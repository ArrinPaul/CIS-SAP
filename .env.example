# Eventra — environment template. Copy to .env.local and fill in real values:
#   cp .env.example .env.local

# --- Authentication (Clerk) — required -----------------------------------
# https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret (whsec_...)
CLERK_WEBHOOK_SECRET=

# --- Database — required --------------------------------------------------
DATABASE_URL=
# Supabase transaction pooler; falls back to DATABASE_URL when unset.
DATABASE_POOLER_URL=

# --- Supabase — required --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App secrets (min 16 chars; required in production) -------------------
JWT_SECRET=
QR_SECRET=
SESSION_SECRET=

# --- App URLs -------------------------------------------------------------
NEXT_PUBLIC_DOMAIN=localhost:9002
NEXT_PUBLIC_APP_URL=http://localhost:9002

# --- Optional integrations (features degrade gracefully when unset) -------
GOOGLE_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
